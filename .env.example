# Copy to .env and fill in values. Never commit .env.

# ---- Neo4j (required) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=change-me            # required; no default
NEO4J_DB=neo4j
NEO4J_ENCRYPTED=0

# ---- Model servers (llama.cpp OpenAI-compatible endpoints) ----
EMBED_BASE_URL=http://127.0.0.1:8080/v1
CHAT_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=qwen3-embed-0.6b
CHAT_MODEL=llama-2-7b-chat
#EMBED_API_KEY=llamacpp
#CHAT_API_KEY=llamacpp

# ---- MCP agent gateway (optional) ----
# URL of an agent gateway that mediates with an MCP server (see qa/mcp_adapter.py)
#MCP_AGENT_URL=
#USE_MCP_BY_DEFAULT=0

# ---- Ingestion / performance (optional; sensible defaults) ----
#DOCS_DIR=./Rag_Docs
#PARSE_WORKERS=8
#EMBED_CONCURRENCY=8
#EMBED_BATCH_SIZE=32
#CHUNK_TARGET_CHARS=1800
#CHUNK_OVERLAP=200
#EMBED_CACHE_DB=embed_cache.sqlite

# ---- Retrieval tuning (optional) ----
#MAX_CTX_TOKENS=2800
#MAX_OUTPUT_TOKENS=192
#PER_DOC_MAX=3
#RERANK_ENABLED=1
#MMR_LAMBDA=0.7

# Cross-encoder reranking (requires: pip install "graph-rag-neo4j[rerank]").
# Joint (query, chunk) scoring; falls back to embedding rerank when unset.
# Suggested: cross-encoder/ms-marco-MiniLM-L-6-v2 or BAAI/bge-reranker-base
#CROSS_ENCODER_MODEL=

# ---- Context awareness (optional) ----
#ANCHOR_DOC_BOOST=0.20          # boost for docs cited in the previous answer
#FOLLOWUP_EMB_WEIGHT=0.75       # current-query weight in follow-up embedding blend
#TOPIC_SHIFT_MIN_OVERLAP=0.15   # below this, the topic stack is cleared
#CORPUS_ENTITY_TTL_SECONDS=600  # corpus entity dictionary refresh interval
#SESSION_SUMMARY_ENABLED=0      # LLM-summarize turns that fall out of the window

# ---- Sessions / feedback (optional) ----
#REDIS_URL=
#SESSION_TTL_MINUTES=60
#SESSION_CLEANUP_EVERY_N_SAVES=50
#FEEDBACK_DB_PATH=.feedback/feedback.db
